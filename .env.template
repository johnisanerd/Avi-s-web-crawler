# Apify API Authentication Token
# Obtain this from your Apify Console -> Settings -> Integrations -> API Tokens
APIFY_API_TOKEN=your_apify_api_token_here

# Optional. Default is a live Google Maps places Actor.
# APIFY_ACTOR_ID=johnvc/google-maps-places-api

# Search settings (comma-separated lists)
SEARCH_QUERIES=residential real estate brokerage, real estate agency, residential real estate agent
LOCATIONS=Miami FL, Orlando FL

# Maximum results to pull per search query (number)
MAX_RESULTS_PER_QUERY=50

# Output configurations
OUTPUT_PATH=leads.xlsx

# Deduplication similarity threshold (0-100)
# 100 means exact match only, lower values merge similar names/addresses
MIN_SIMILARITY_SCORE=85
